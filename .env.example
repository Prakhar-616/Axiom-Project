# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NTFY_TOPIC: Real-time public push alert topic (defaults to axiom-india-nodal-alerts on https://ntfy.sh).
# Citizens and officers can subscribe on Android/iOS/Web at https://ntfy.sh/axiom-india-nodal-alerts
NTFY_TOPIC="axiom-india-nodal-alerts"

# Optional: Telegram Bot API credentials for posting real alerts to a Telegram Channel/Group
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional: Custom Webhook URL for Municipal / I4C / Slack / WhatsApp Business Gateway
ALERT_WEBHOOK_URL=""
